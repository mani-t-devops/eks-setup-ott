# cp .env.example .env  and fill in. Never commit .env
AWS_REGION=us-east-1
CLUSTER_NAME=ott-lab

# Google Chat: Space -> Apps & integrations -> Webhooks -> Add webhook -> copy URL
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=XXXX&token=XXXX

GRAFANA_PASSWORD=change-me-please

# Datadog (optional — leave DD_API_KEY empty to skip Datadog entirely)
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
# false on the Datadog Free plan (no alerting there)
DD_ENABLE_MONITORS=true
